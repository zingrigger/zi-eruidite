---
import LenticularSection from "@/components/LenticularSection.astro"
import ListingHead from "@/components/ListingHead.astro"
import { t, type Locale } from "@/lib/i18n"

type Props = {
  locale: Locale
}

const { locale } = Astro.props
---

<ListingHead
  kicker="~/board/lenticular-card"
  title={t(locale, "boardLensTitle")}
  desc={t(locale, "lenticularDesc")}
/>
<LenticularSection locale={locale} />
