---

<ticket-showcase data-theme="solid">
  <ticket-controls>
    <ticket-theme role="group" aria-label={t(locale, "boardTicketTheme")}>
      <button
        type="button"
        class="tk-theme-btn"
        data-theme-btn="solid"
        aria-pressed="true"
      >
        {t(locale, "boardTicketSolid")}
      </button>
      <button
        type="button"
        class="tk-theme-btn"
        data-theme-btn="image"
        aria-pressed="false"
      >
        {t(locale, "boardTicketImage")}
      </button>
    </ticket-theme>
  </ticket-controls>
  <ticket-collage>
    {TICKETS.map((t) => (
        <ticket-slot>
          <TicketCard
            variant={t.variant}
            orient={t.orient}
            invert={t.invert}
            label={t.label}
            amount={t.amount}
            title={t.title}
            sub={t.sub}
            code={t.code}
            meta={t.meta}
            seed={t.seed}
            width={t.width}
            rot={t.rot}
            image={t.image}
          />
        </ticket-slot>
      ))}
  </ticket-collage>
</ticket-showcase>

<script>
  import { mountTicketTilt, type TiltHandle } from "@/lib/ticket-tilt"
  /**
   * 自主定制元素：SSR 出的就是完整票券，挂载时接上「默认/图片」主题切换与悬停倾斜。
   * 注册与生命周期跟 LenticularCard 对齐：View Transitions / HMR 会重跑脚本，所以先查
   * customElements.get（否则 define 抛 NotSupportedError，整个模块就地中断）；
   * 「已挂载」标记用实例私有字段而不是 dataset——dataset 留在 DOM 上，元素被重新
   * 升级时会误报「已就绪」而永不挂监听。断开时 destroy，免得监听与 rAF 活过这个页面。
   */
  if (!customElements.get("ticket-showcase")) {
    customElements.define(
      "ticket-showcase",
      class extends HTMLElement {
        #cleanups: (() => void)[] | null = null

        connectedCallback(): void {
          if (this.#cleanups) return
          const cleanups: (() => void)[] = []
          const themeBtns =
            this.querySelectorAll<HTMLButtonElement>("[data-theme-btn]")
          for (const btn of themeBtns) {
            const onClick = (): void => {
              this.dataset.theme = btn.dataset.themeBtn || "solid"
              for (const b of themeBtns)
                b.setAttribute("aria-pressed", String(b === btn))
            }
            btn.addEventListener("click", onClick)
            cleanups.push(() => btn.removeEventListener("click", onClick))
          }
          const tilt: TiltHandle = mountTicketTilt(this)
          cleanups.push(() => tilt.destroy())
          this.#cleanups = cleanups
        }

        disconnectedCallback(): void {
          for (const off of this.#cleanups ?? []) off()
          this.#cleanups = null
        }
      },
    )
  }
</script>

<style>
  ticket-showcase {
    display: block;
  }
  ticket-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-2xs) var(--space-3xs);
    padding-top: var(--space-s);
  }
  ticket-theme {
    display: flex;
    gap: var(--space-3xs);
  }
  .tk-theme-btn {
    font: inherit;
    font-size: var(--step--1);
    padding: var(--space-3xs) var(--space-s);
    border: 1px solid var(--border);
    border-radius: 999px;
    background: transparent;
    color: var(--muted-foreground);
    cursor: pointer;
  }
  .tk-theme-btn[aria-pressed="true"] {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  .tk-theme-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  ticket-collage {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-l) var(--space-m);
    /* 与上下内容留白；暗色下靠各卡 drop-shadow 把白卡托起 */
    padding-block: var(--space-m) var(--space-xl);
  }
  ticket-slot {
    display: inline-block;
    /* 3D 倾斜落在此（父），票券的 filter:drop-shadow 在子 card 上，互不压平。
       变量叫 --tk-rx/--tk-ry 而非 --rx/--ry：后者已被 lenticular.css 用 @property
       注册成文档级全局的 <number>，而 @property 无作用域——往它写 8deg 会因
       syntax 不匹配而 invalid at computed-value time（落回 initial 0），倾角永远为 0。 */
    transform: translateY(var(--stagger, 0px)) perspective(800px)
      rotateX(var(--tk-rx, 0deg)) rotateY(var(--tk-ry, 0deg));
  }
  /* 奇偶错位，强化「随手摊在桌上」的拼贴感（旋转留在卡上，两者互不覆盖） */
  ticket-collage > ticket-slot:nth-child(even) {
    --stagger: var(--space-m);
  }
</style>
