  label: string
  amount: string
  title?: string
  sub?: string
  code?: string
  meta?: { k: string; v: string }[]
  seed: number
  width: string
  rot: number
  /** 图片主题下填实心蓝侧的插画（复用板上现有资产，逐张分配） */
  image: ImageMetadata
}

