---
import HairlineFigure from "@/components/HairlineFigure.astro"
import MetaPage from "@/components/MetaPage.astro"
import TagMosaic from "@/components/TagMosaic.astro"
import Layout from "@/layouts/Layout.astro"
import { getAllTags } from "@/lib/content"

const tags = await getAllTags()
const entries = [...tags].map(([tag, { blog, moments }]) => ({
  tag,
  href: `/tags/${tag}`,
  blog: blog.length,
  moments: moments.length,
  total: blog.length + moments.length,
}))
const totalRefs = entries.reduce((n, entry) => n + entry.total, 0)
---

<Layout crumbs={[{ label: "标签", href: "/tags" }]}>
  <MetaPage slot="head" title="标签" noindex />
  <header class="tags-head">
    <div class="tags-head-text">
      <p class="tags-kicker">~/tags · {tags.size} tags</p>
      <h1 class="tags-title">标签</h1>
      <p class="tags-desc">按标签浏览博客与动态。</p>
    </div>
    <div class="tags-head-figure">
      <HairlineFigure
        figure="phosphor"
        label="七乘七余辉点阵，像散落的标签，指针划过时依次亮起"
        width="176px"
        play
      />
    </div>
  </header>
  <tags-explorer>
    {tags.size > 0 && (
      <div class="tags-toolbar">
        <span class="tags-legend">
          面积 = 被引用次数（共 {totalRefs} 次）
        </span>
        <label class="tags-switch">
          <span class="tags-switch-label">瓷砖视图</span>
          <input type="checkbox" role="switch" autocomplete="off" />
          <span class="tags-switch-track" aria-hidden="true">
            <span class="tags-switch-thumb" />
          </span>
        </label>
      </div>
    )}
    <ul class="tags-list">
      {[...tags].map(([tag, { blog, moments }]) => {
          const total = blog.length + moments.length
          return (
            <li>
              <a href={`/tags/${tag}`}
                >#{tag}<tag-count>{total}</tag-count></a
              >
            </li>
          )
        })}
    </ul>
    {tags.size > 0 && <TagMosaic tags={entries} />}
  </tags-explorer>
</Layout>

<style>
  .tags-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-m);
    padding-bottom: var(--space-s);
    margin-bottom: var(--space-l);
    border-bottom: 1px solid var(--border);
  }

  .tags-head-text {
    min-width: 0;
  }

  .tags-head-figure {
    flex-shrink: 0;
    line-height: 0;
    /* phosphor 墨迹（实测 55 笔联合包围盒）中心比文字块中心高约 16px，
       下移墨迹光学中心至与标题块居中；离底部分隔线尚有 ~29px，不压线 */
    margin-bottom: -18px;
    transform: translateY(10px);
  }

  .tags-kicker {
    font-family: var(--font-mono);
    font-size: calc(var(--step--1) - 1px);
    letter-spacing: 0.04em;
    color: var(--muted-foreground);
    margin: 0 0 var(--space-3xs);
  }

  .tags-title {
    font-size: var(--step-3);
    font-weight: 610;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--accent);
    margin: 0;
  }

  .tags-desc {
    margin: var(--space-2xs) 0 0;
    font-size: var(--step--1);
    line-height: 1.5;
    color: var(--muted-foreground);
  }

  .tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);

    a {
      display: inline-block;
      padding-inline: var(--space-2xs);
      font-size: var(--step--1);
      color: var(--muted-foreground);
      background-color: color-mix(in oklab, var(--muted) 50%, transparent);
      border-radius: var(--radius-full);
      text-decoration-line: none;

      &:hover {
        color: var(--foreground);
      }

      tag-count {
        margin-inline-start: var(--space-3xs);
        opacity: 0.6;
      }
    }
  }

  tags-explorer {
    display: block;
    --tags-view-mosaic: none;
  }

  tags-explorer:has(.tags-switch input:checked) .tags-list {
    display: none;
  }

  tags-explorer:has(.tags-switch input:checked) {
    --tags-view-mosaic: block;
  }

  tags-explorer:has(.tags-switch input:checked) .tags-legend {
    visibility: visible;
    opacity: 1;
  }

  .tags-toolbar {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    min-height: 1.75rem;
    margin-bottom: var(--space-m);
  }

  .tags-legend {
    min-width: 0;
    font-family: var(--font-mono);
    font-size: calc(var(--step--1) - 1px);
    color: var(--muted-foreground);
    visibility: hidden;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .tags-switch {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: var(--space-2xs);
    margin-inline-start: auto;
    cursor: pointer;
  }

  .tags-switch-label {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--muted-foreground);
  }

  .tags-switch:hover .tags-switch-label {
    color: var(--foreground);
  }

  .tags-switch input {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .tags-switch-track {
    position: relative;
    display: inline-block;
    box-sizing: border-box;
    width: 2.25rem;
    height: 1.25rem;
    background: var(--gray-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    transition:
      background-color 0.18s ease,
      border-color 0.18s ease;
  }

  .tags-switch-thumb {
    position: absolute;
    top: 50%;
    left: 0.125rem;
    width: 1rem;
    height: 1rem;
    background: var(--background);
    border-radius: var(--radius-full);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.2);
    transform: translateY(-50%);
    transition: transform 0.18s ease;
  }

  .tags-switch input:checked + .tags-switch-track {
    background: var(--accent);
    border-color: var(--accent);
  }

  .tags-switch input:checked + .tags-switch-track .tags-switch-thumb {
    transform: translate(1rem, -50%);
  }

  .tags-switch input:focus-visible + .tags-switch-track {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }

  @media (width < 640px) {
    /* 窄屏留给阅读栏，插图只在宽屏出现 */
    .tags-head-figure {
      display: none;
    }
  }
</style>
