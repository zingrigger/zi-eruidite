---
import Layout from "@/layouts/Layout.astro"
import MetaPage from "@/components/MetaPage.astro"
import ListingHead from "@/components/ListingHead.astro"
import Board from "@/components/Board.astro"
import LenticularSection from "@/components/LenticularSection.astro"
import TicketSection from "@/components/TicketSection.astro"
import BirdBoard from "@/components/BirdBoard.astro"
import { getBirdViews, getBoardViews } from "@/lib/content"
import { t } from "@/lib/i18n"

const items = await getBoardViews("en")
const birds = await getBirdViews("en")
---

<Layout>
  <MetaPage
    slot="head"
    title="Board"
    description="A collage of stamps and tech-stack badges you can rearrange by dragging."
    alternates={{ zh: "/board", en: "/en/board" }}
  />
  <board-section>
    <ListingHead
      kicker={`~/board · ${items.length} pieces`}
      title="Board"
      desc="Stamps (including custom stamps built from any image) and tech-stack badges, laid out on one board. Grab a piece and drag it anywhere to rearrange the collage."
    />
    <Board locale="en" />
  </board-section>
  <ListingHead kicker={`~/LenticularCard`} title="Lenticular Card" />
  <LenticularSection locale="en" />
  <ListingHead kicker="~/TicketCard" title="Tickets" />
  <TicketSection locale="en" />
  <ListingHead
    kicker={`~/birds · ${birds.length} species`}
    title={t("en", "birdsTitle")}
    desc={t("en", "birdsDesc")}
  />
  <BirdBoard locale="en" />
  <!-- Attribution (required): stickers PolyForm Shield 1.0.0; data MIT;
       taxonomy & names IOC v15.2 CC BY 3.0; traits AVONET CC BY 4.0. -->
  <p class="birds-credit">
    {t("en", "birdsCredit")}
    <a
      href="https://github.com/alchaincyf/huashu-bird-sticker"
      target="_blank"
      rel="noopener noreferrer"
      >Repository</a
    >
    ·
    <a
      href="https://github.com/alchaincyf/huashu-bird-sticker/blob/main/LICENSE.md"
      target="_blank"
      rel="noopener noreferrer"
      >License</a
    >
  </p>
</Layout>

<style>
  /* The board is not suited to touch screens (<64rem): hide the whole block
     (header included) and drop its nav entry on phones; the lenticular card,
     tickets and bird board below stay visible. */
  @media (width < 64rem) {
    board-section {
      display: none;
    }
  }

  .birds-credit {
    max-width: 60ch;
    margin: var(--space-l) auto 0;
    color: var(--muted-foreground);
    font-size: var(--step--1);
    text-align: center;
  }

  .birds-credit a {
    color: var(--accent);
    text-underline-offset: 2px;
  }
</style>
